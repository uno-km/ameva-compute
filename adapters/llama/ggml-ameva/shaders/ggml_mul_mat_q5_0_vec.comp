#version 450
// dst[m][n] = sum_k dequant_q5_0(src0)[n][k] * src1[m][k], reading src0 in its raw ggml Q5_0 layout, so the
// weights stay where llama.cpp loaded them (the AMEVA model buffer) and are never expanded to F32.
//
//   binding 0: src0 raw bytes; row n starts at offset_src0 + n * (K/32) * 22 (offset_src0 in BYTES, multiple of 4)
//              block = { fp16 d; uint8 qh[4]; uint8 qs[16] } (22 bytes, 2-byte packed: blocks are only 2-aligned)
//   binding 1: src1 F32 read as vec4, row m at offset_src1 + m*K floats (host guarantees offset_src1 % 4 == 0)
//   binding 2: dst  F32, dst[offset_dst + m*N + n]
//   push constants (same layout as ggml_mul_mat.comp): M, K, N, offset_src0 (bytes), offset_src1, offset_dst
//   grid ((N+3)/4, M): one workgroup = 4 output rows of one activation row; 16 lanes per output row stride the
//   row's blocks, so neighbouring lanes read neighbouring blocks (coalesced).
//
// Dequantization is ggml's dequantize_row_q5_0, done four values per 32-bit word:
//   q[j]    = (qs[j] & 0xF) | (qh bit j      << 4)   for j in 0..15
//   q[j+16] = (qs[j] >> 4)  | (qh bit (j+16) << 4)
//   value   = (q - 16) * d, with d factored out of the block sum.
// The first version extracted one byte per iteration with scalar shifts; on Mali-G68 that made the kernel ALU-bound
// (~1.2 GB/s effective). Word-wide nibble masks and vec4 dot products cut the per-block instruction count.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer Src0 { uint wq[]; };
layout(std430, binding = 1) readonly buffer Src1 { vec4 src1v[]; };
layout(std430, binding = 2) writeonly buffer Dst { float dst[]; };

layout(push_constant) uniform PushConstants {
    uint M;
    uint K;
    uint N;
    uint offset_src0; // bytes
    uint offset_src1; // floats, multiple of 4
    uint offset_dst;
} pc;

#define LANES 16u
shared float red[64];

uint load_word(uint idx, uint last) {
    return wq[min(idx, last)]; // words past the buffer end only feed bytes outside the block
}

// bit k (k = 0..3) of x moved to bit 4 of byte k
uint spread4(uint x) {
    return ((x & 1u) << 4u) | ((x & 2u) << 11u) | ((x & 4u) << 18u) | ((x & 8u) << 25u);
}

vec4 bytes_minus16(uint w) {
    return vec4(uvec4(w, w >> 8u, w >> 16u, w >> 24u) & 0xFFu) - 16.0;
}

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint r = tid / LANES;
    const uint lane = tid % LANES;
    const uint n = gl_WorkGroupID.x * 4u + r;
    const uint m = gl_WorkGroupID.y;
    const uint nb = pc.K >> 5;
    const uint last = uint(wq.length()) - 1u;

    float acc = 0.0;
    if (n < pc.N) {
        const uint row = pc.offset_src0 + n * nb * 22u;
        const uint arow4 = (pc.offset_src1 + m * pc.K) >> 2u;
        for (uint b = lane; b < nb; b += LANES) {
            const uint base = row + b * 22u;            // even
            const uint w0 = base >> 2;
            uint v[6];
            if ((base & 2u) == 0u) {
                for (uint i = 0u; i < 6u; ++i) v[i] = load_word(w0 + i, last);
            } else {                                     // block starts mid-word: shift every word down by 16 bits
                uint prev = load_word(w0, last);
                for (uint i = 0u; i < 6u; ++i) {
                    const uint next = load_word(w0 + i + 1u, last);
                    v[i] = (prev >> 16u) | (next << 16u);
                    prev = next;
                }
            }
            // v[0] = d(2) qh0 qh1, v[1] = qh2 qh3 qs0 qs1, v[2..5] = qs2..qs15
            const float d = unpackHalf2x16(v[0] & 0xFFFFu).x;
            const uint qh = (v[0] >> 16u) | (v[1] << 16u);
            const uint ab4 = arow4 + b * 8u;             // 32 activations = 8 vec4
            float s = 0.0;
            for (uint i = 0u; i < 4u; ++i) {
                const uint qs = (v[1u + i] >> 16u) | (v[2u + i] << 16u); // qs[4i .. 4i+3]
                const uint lo = (qs & 0x0F0F0F0Fu) | spread4(qh >> (4u * i));
                const uint hi = ((qs >> 4u) & 0x0F0F0F0Fu) | spread4(qh >> (16u + 4u * i));
                s += dot(bytes_minus16(lo), src1v[ab4 + i]) + dot(bytes_minus16(hi), src1v[ab4 + 4u + i]);
            }
            acc += d * s;
        }
    }

    red[tid] = acc;
    barrier();
    for (uint st = LANES / 2u; st > 0u; st >>= 1u) {
        if (lane < st) {
            red[tid] += red[tid + st];
        }
        barrier();
    }
    if (lane == 0u && n < pc.N) {
        dst[pc.offset_dst + m * pc.N + n] = red[tid];
    }
}
