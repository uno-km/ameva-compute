#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : require
// AMEVA FLASH_ATTN_EXT, tiled (FlashAttention-2 forward):
//   softmax(scale * Q K^T [softcap] + slope * mask) V
//   q f32 [D, n_q, n_head] (any strides), k [D, n_kv, n_head_kv] and v [DV, n_kv, n_head_kv] each in f32, f16, q8_0
//   or q4_0 (any row and head strides; K and V types independent; a quantized head row is whole ggml blocks, D or DV a
//   multiple of 32), mask f16 [n_kv, >= n_q, mask_ne2] optional, dst f32 [DV, n_head, n_q] contiguous.
//   Grouped-query attention: head h reads KV head h / G (G = n_head / n_head_kv). ALiBi slopes as in ggml.
//
// A workgroup of 128 invocations owns BQ rows that read the same KV head; a row is one (query position, head of the
// KV group) pair, so the G heads of a group share every K and V load (token generation: one workgroup per KV head
// holds all G heads). Keys are processed in blocks of BK:
//   0. each invocation reads the mask of its BK / (128 / BQ) keys; a block masked out for every row of the tile is
//      skipped (causal prompts, KV cache padding);
//   1. the block's K is staged in shared memory as f32 (exact f16 conversion; q8_0 / q4_0 dequantized exactly as
//      ggml's dequantize_row_q8_0 / q4_0);
//   2. each invocation computes the scores of its keys for its row and the per-invocation maximum;
//   3. the row maximum of the block updates the running maximum (online softmax), the probabilities go to shared
//      memory and the block's V replaces K;
//   4. each invocation rescales and accumulates its DMAX / (128 / BQ) output columns.
// Scores, probabilities and accumulation are f32 (ggml's CPU kernel rounds Q to f16 and accumulates V in f16 when V is
// f16). Variants: -DDMAX=64|128|256 (at least max(D, DV); D and DV multiples of 4), -DBQ, -DBK, -DRPI, -DDUNROLL.
// RPI rows per invocation (default 1): an invocation computes the scores of RPI rows x KPT keys and accumulates RPI
// rows x NV output vec4, so each staged K / V vec4 it reads serves RPI rows (fewer shared-memory reads and barriers
// per row). DUNROLL head-loop steps per iteration (default 1, a loop over D / 4; a divisor of DMAX / 4): above 1 the
// loop runs over DMAX / 4 vec4 with Q and K zero past D. Either way the sums are those of a loop over D (adding exact
// zeros), in the same order for every RPI and DUNROLL.
//
// Key splits (flash decoding): with split_keys > 0, workgroup z handles keys [z * split_keys, (z + 1) * split_keys)
// and writes its partial result per output row r = iq1 * n_head + iq2 to binding 5 at
// part_off + (z * n_q * n_head + r) * (DV + 2): running maximum m, sum l, then the DV unnormalized accumulators.
// ameva_fa_combine merges the splits. In token generation a tile holds every row of a KV head, so without splits the
// whole cache of a head is walked by one workgroup.
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

#include "ameva_common.glsl"

layout(std430, binding = 0) readonly buffer Q { uint q[]; };
layout(std430, binding = 1) readonly buffer K { uint k[]; };
layout(std430, binding = 2) readonly buffer V { uint v[]; };
layout(std430, binding = 3) readonly buffer M { uint mask[]; };
layout(std430, binding = 4) writeonly buffer O { uint o[]; };
layout(std430, binding = 5) writeonly buffer Part { uint part[]; }; // split partials (any range when split_keys == 0)

layout(push_constant) uniform PushConstants {
    uint D, DV, n_kv, n_q;
    uint n_head, n_head_kv, kv_types, has_mask; // kv_types: K type in bits 0..3, V type in bits 4..7
    uint q_off, q_s1, q_s2, k_off;   // K and V offsets and strides: elements (f32, f16) or bytes (q8_0, q4_0)
    uint k_s1, k_s2, v_off, v_s1;
    uint v_s2, m_off, m_s1, m_s2;
    uint m_ne2, o_off, scale, softcap;
    uint max_bias, m0, m1, n_head_log2;
    uint tile_base; // first tile of this dispatch (long prompts are split over several dispatches)
    uint split_keys, part_off;
} pc;

#ifndef DMAX
#define DMAX 64u
#endif
#ifndef BQ
#define BQ 16u
#endif
#ifndef BK
#define BK 32u
#endif
#ifndef RPI
#define RPI 1u                 // rows per invocation (register tile: RPI rows x KPT keys, RPI rows x NV columns)
#endif
#ifndef DUNROLL
#define DUNROLL 1u             // head-loop vec4 steps per iteration: 1 = a loop over D / 4, QS = fully unrolled
#endif
#define DEND (DUNROLL == 1u ? D4 : QS)
#define TPR (128u * RPI / BQ)  // invocations per row
#define RG (BQ / RPI)          // invocations per key / column lane; row i_a = rg + RG * a
#define KPT (BK / TPR)         // keys per invocation and block
#define NV (DMAX / 4u / TPR)   // output vec4 per invocation and row
#define QS (DMAX / 4u)         // vec4 per staged Q row
#define KS (DMAX / 4u + 1u)    // vec4 per staged K/V row (padded: neighbouring keys in different banks)

shared vec4 sQ[BQ * QS];
shared vec4 sKV[BK * KS];
shared float sP[BQ * BK];
shared float sMax[BQ * TPR];
shared uint sAny[2]; // per block parity: some key of the block is unmasked for some row

// K / V element types (pc.kv_types)
#define KV_F32 0u
#define KV_F16 1u
#define KV_Q8_0 2u
#define KV_Q4_0 3u

uint kv_word(bool is_k, uint wi) { return is_k ? k[wi] : v[wi]; }
// 4 bytes starting at the even byte address p (ggml blocks are 34 / 18 bytes: fields start at even addresses)
uint kv_bytes4(bool is_k, uint p) {
    const uint w0 = kv_word(is_k, p >> 2u);
    if ((p & 2u) == 0u) return w0;
    return (w0 >> 16u) | (kv_word(is_k, (p >> 2u) + 1u) << 16u);
}
float kv_half(bool is_k, uint p) { return ameva_h2f((kv_word(is_k, p >> 2u) >> ((p & 2u) * 8u)) & 0xFFFFu); }

// elements e .. e + 3 (e a multiple of 4) of a K (is_k) or V row that starts at `row`: an element index (f32, f16)
// or a byte address (q8_0, q4_0). Uniform branch: the type is the same for the whole dispatch.
vec4 load4(bool is_k, uint row, uint e) {
    const uint t = is_k ? (pc.kv_types & 15u) : ((pc.kv_types >> 4u) & 15u);
    if (t == KV_F32) {
        const uint idx = row + e;
        return uintBitsToFloat(uvec4(kv_word(is_k, idx), kv_word(is_k, idx + 1u), kv_word(is_k, idx + 2u),
                                     kv_word(is_k, idx + 3u)));
    }
    if (t == KV_F16) {
        const uint idx = row + e;
        if ((idx & 1u) == 0u) {
            const uint w0 = kv_word(is_k, idx >> 1u), w1 = kv_word(is_k, (idx >> 1u) + 1u);
            return vec4(ameva_h2f(w0 & 0xFFFFu), ameva_h2f(w0 >> 16u), ameva_h2f(w1 & 0xFFFFu), ameva_h2f(w1 >> 16u));
        }
        return is_k ? vec4(AMEVA_LOAD_F16(k, idx), AMEVA_LOAD_F16(k, idx + 1u), AMEVA_LOAD_F16(k, idx + 2u),
                           AMEVA_LOAD_F16(k, idx + 3u))
                    : vec4(AMEVA_LOAD_F16(v, idx), AMEVA_LOAD_F16(v, idx + 1u), AMEVA_LOAD_F16(v, idx + 2u),
                           AMEVA_LOAD_F16(v, idx + 3u));
    }
    const uint b = e >> 5u, j = e & 31u;
    if (t == KV_Q8_0) {
        // block: d f16 @0, qs int8[32] @2. y = qs[j] * d
        const uint bb = row + 34u * b;
        const int x = int(kv_bytes4(is_k, bb + 2u + j));
        return vec4(bitfieldExtract(x, 0, 8), bitfieldExtract(x, 8, 8), bitfieldExtract(x, 16, 8),
                    bitfieldExtract(x, 24, 8)) * kv_half(is_k, bb);
    }
    // KV_Q4_0 block: d f16 @0, qs[16] @2; element j < 16 is the low nibble of qs[j], j >= 16 the high nibble of
    // qs[j - 16]. y = (nibble - 8) * d
    const uint bb = row + 18u * b;
    const uint w = kv_bytes4(is_k, bb + 2u + (j & 15u));
    const uint n = j < 16u ? (w & 0x0F0F0F0Fu) : ((w >> 4u) & 0x0F0F0F0Fu);
    return (vec4(uvec4(n, n >> 8u, n >> 16u, n >> 24u) & 0xFFu) - 8.0) * kv_half(is_k, bb);
}

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint G = pc.n_head / pc.n_head_kv;
    const uint hkv = gl_WorkGroupID.y;
    const uint tile = pc.tile_base + gl_WorkGroupID.x;
    const uint nrows = pc.n_q * G;
    const uint rg = tid / TPR;    // rows rg + RG * a (a < RPI) of the tile are this invocation's
    const uint lane = tid % TPR;
    const uint D4 = pc.D >> 2u, DV4 = pc.DV >> 2u;

    // Q rows of the tile (zero past the last row and past D)
    for (uint e = tid; e < BQ * QS; e += 128u) {
        const uint ii = e / QS, d4 = e % QS;
        const uint rr = tile * BQ + ii;
        vec4 x = vec4(0.0);
        if (rr < nrows && d4 < D4) {
            const uint b = pc.q_off + (rr / G) * pc.q_s1 + (hkv * G + rr % G) * pc.q_s2 + 4u * d4;
            x = uintBitsToFloat(uvec4(q[b], q[b + 1u], q[b + 2u], q[b + 3u]));
        }
        sQ[e] = x;
    }
    if (tid < 2u) sAny[tid] = 0u;

    float scale = uintBitsToFloat(pc.scale);
    const float softcap = uintBitsToFloat(pc.softcap);
    if (softcap != 0.0) scale /= softcap;
    const float max_bias = uintBitsToFloat(pc.max_bias);
    const float NEG_INF = -1.0 / 0.0;

    bool row_ok[RPI];
    uint iq1[RPI];
    uint iq2[RPI];
    uint mrow[RPI];
    float slope[RPI];
    [[unroll]] for (uint a = 0u; a < RPI; ++a) {
        const uint r = tile * BQ + rg + RG * a;
        row_ok[a] = r < nrows;
        const uint rc = min(r, nrows - 1u);
        iq1[a] = rc / G;
        iq2[a] = hkv * G + rc % G;
        mrow[a] = pc.m_off + iq1[a] * pc.m_s1 + (iq2[a] % pc.m_ne2) * pc.m_s2;
        float sl = 1.0;
        if (max_bias > 0.0) {
            sl = iq2[a] < pc.n_head_log2 ? pow(uintBitsToFloat(pc.m0), float(iq2[a] + 1u))
                                         : pow(uintBitsToFloat(pc.m1), float(2u * (iq2[a] - pc.n_head_log2) + 1u));
        }
        slope[a] = sl;
    }
    const uint kbase = pc.k_off + hkv * pc.k_s2;
    const uint vbase = pc.v_off + hkv * pc.v_s2;
    const uint split = gl_WorkGroupID.z;
    const uint kv_begin = pc.split_keys != 0u ? split * pc.split_keys : 0u;
    const uint kv_end = pc.split_keys != 0u ? min(pc.n_kv, kv_begin + pc.split_keys) : pc.n_kv;

    vec4 acc[RPI * NV];
    [[unroll]] for (uint n = 0u; n < RPI * NV; ++n) {
        acc[n] = vec4(0.0);
    }
    float m_run[RPI];
    float l_run[RPI];
    [[unroll]] for (uint a = 0u; a < RPI; ++a) {
        m_run[a] = NEG_INF;
        l_run[a] = 0.0;
    }
    barrier();

    uint blk = 0u;
    for (uint kb = kv_begin; kb < kv_end; kb += BK, ++blk) {
        // 0. mask of this invocation's keys (-inf: masked or past the key range or not a row of the tile)
        float mv[RPI * KPT];
        bool any = false;
        [[unroll]] for (uint a = 0u; a < RPI; ++a) {
            [[unroll]] for (uint c = 0u; c < KPT; ++c) {
                const uint j = kb + lane + TPR * c;
                float m = NEG_INF;
                if (row_ok[a] && j < kv_end) {
                    m = pc.has_mask != 0u ? slope[a] * AMEVA_LOAD_F16(mask, mrow[a] + j) : 0.0;
                }
                mv[a * KPT + c] = m;
                any = any || m != NEG_INF;
            }
        }
        if (any) sAny[blk & 1u] = 1u;
        // the other flag was last read before a barrier this invocation has passed (or in a skipped block, where it
        // was 0 already)
        if (tid == 0u) sAny[(blk + 1u) & 1u] = 0u;
        barrier();
        if (sAny[blk & 1u] == 0u) {
            continue; // uniform: every key of the block is masked for every row
        }

        // 1. K of the block (zero past D, so that the head loop can run over DMAX / 4 vec4)
        for (uint e = tid; e < BK * QS; e += 128u) {
            const uint j = e / QS, d4 = e % QS;
            sKV[j * KS + d4] =
                (kb + j < kv_end && d4 < D4) ? load4(true, kbase + (kb + j) * pc.k_s1, 4u * d4) : vec4(0.0);
        }
        barrier();

        // 2. scores of this invocation's rows and keys: each staged Q and K vec4 is read once per head-loop step
        float s[RPI * KPT];
        [[unroll]] for (uint x = 0u; x < RPI * KPT; ++x) {
            s[x] = 0.0;
        }
        [[dont_unroll]] for (uint d0 = 0u; d0 < DEND; d0 += DUNROLL) {
            [[unroll]] for (uint du = 0u; du < DUNROLL; ++du) {
                const uint d4 = d0 + du;
                vec4 qv[RPI];
                [[unroll]] for (uint a = 0u; a < RPI; ++a) {
                    qv[a] = sQ[(rg + RG * a) * QS + d4];
                }
                [[unroll]] for (uint c = 0u; c < KPT; ++c) {
                    const vec4 kv = sKV[(lane + TPR * c) * KS + d4];
                    [[unroll]] for (uint a = 0u; a < RPI; ++a) {
                        s[a * KPT + c] += dot(qv[a], kv);
                    }
                }
            }
        }
        [[unroll]] for (uint a = 0u; a < RPI; ++a) {
            float mloc = NEG_INF;
            [[unroll]] for (uint c = 0u; c < KPT; ++c) {
                float x = NEG_INF;
                if (mv[a * KPT + c] != NEG_INF) {
                    x = s[a * KPT + c] * scale;
                    if (softcap != 0.0) x = softcap * ameva_tanh(x);
                    x += mv[a * KPT + c];
                }
                s[a * KPT + c] = x;
                mloc = max(mloc, x);
            }
            sMax[(rg + RG * a) * TPR + lane] = mloc;
        }
        barrier();

        // 3. running maximum of each row, probabilities, V of the block
        float m_new[RPI];
        [[unroll]] for (uint a = 0u; a < RPI; ++a) {
            const uint i = rg + RG * a;
            float mblk = NEG_INF;
            [[unroll]] for (uint l2 = 0u; l2 < TPR; ++l2) {
                mblk = max(mblk, sMax[i * TPR + l2]);
            }
            m_new[a] = max(m_run[a], mblk);
            [[unroll]] for (uint c = 0u; c < KPT; ++c) {
                const float x = s[a * KPT + c];
                sP[i * BK + lane + TPR * c] = (m_new[a] == NEG_INF || x == NEG_INF) ? 0.0 : exp(x - m_new[a]);
            }
        }
        for (uint e = tid; e < BK * DV4; e += 128u) {
            const uint j = e / DV4, d4 = e % DV4;
            sKV[j * KS + d4] = kb + j < kv_end ? load4(false, vbase + (kb + j) * pc.v_s1, 4u * d4) : vec4(0.0);
        }
        barrier();

        // 4. rescale and accumulate this invocation's output columns of its rows: each staged V vec4 serves RPI rows
        float lblk[RPI];
        [[unroll]] for (uint a = 0u; a < RPI; ++a) {
            const float alpha = m_run[a] == NEG_INF ? 0.0 : exp(m_run[a] - m_new[a]);
            [[unroll]] for (uint n = 0u; n < NV; ++n) {
                acc[a * NV + n] *= alpha;
            }
            l_run[a] *= alpha;
            lblk[a] = 0.0;
        }
        for (uint jl = 0u; jl < BK; ++jl) {
            vec4 vv[NV];
            [[unroll]] for (uint n = 0u; n < NV; ++n) {
                vv[n] = sKV[jl * KS + lane + TPR * n];
            }
            [[unroll]] for (uint a = 0u; a < RPI; ++a) {
                const float p = sP[(rg + RG * a) * BK + jl];
                lblk[a] += p;
                [[unroll]] for (uint n = 0u; n < NV; ++n) {
                    acc[a * NV + n] += p * vv[n];
                }
            }
        }
        [[unroll]] for (uint a = 0u; a < RPI; ++a) {
            l_run[a] += lblk[a];
            m_run[a] = m_new[a];
        }
        barrier();
    }

    [[unroll]] for (uint a = 0u; a < RPI; ++a) {
        if (!row_ok[a]) continue;
        if (pc.split_keys != 0u) {
            const uint pb = pc.part_off + (split * pc.n_q * pc.n_head + iq1[a] * pc.n_head + iq2[a]) * (pc.DV + 2u);
            if (lane == 0u) {
                part[pb] = floatBitsToUint(m_run[a]);
                part[pb + 1u] = floatBitsToUint(l_run[a]);
            }
            [[unroll]] for (uint n = 0u; n < NV; ++n) {
                const uint d4 = lane + TPR * n;
                if (d4 < DV4) {
                    const vec4 x = acc[a * NV + n];
                    part[pb + 2u + 4u * d4 + 0u] = floatBitsToUint(x.x);
                    part[pb + 2u + 4u * d4 + 1u] = floatBitsToUint(x.y);
                    part[pb + 2u + 4u * d4 + 2u] = floatBitsToUint(x.z);
                    part[pb + 2u + 4u * d4 + 3u] = floatBitsToUint(x.w);
                }
            }
        } else {
            const float inv = l_run[a] == 0.0 ? 0.0 : 1.0 / l_run[a];
            const uint ob = pc.o_off + (iq1[a] * pc.n_head + iq2[a]) * pc.DV;
            [[unroll]] for (uint n = 0u; n < NV; ++n) {
                const uint d4 = lane + TPR * n;
                if (d4 < DV4) {
                    const vec4 x = acc[a * NV + n] * inv;
                    o[ob + 4u * d4 + 0u] = floatBitsToUint(x.x);
                    o[ob + 4u * d4 + 1u] = floatBitsToUint(x.y);
                    o[ob + 4u * d4 + 2u] = floatBitsToUint(x.z);
                    o[ob + 4u * d4 + 3u] = floatBitsToUint(x.w);
                }
            }
        }
    }
}
