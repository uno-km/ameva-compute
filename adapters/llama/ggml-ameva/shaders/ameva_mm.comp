#version 450
#extension GL_GOOGLE_include_directive : require
// AMEVA MM: ggml MUL_MAT of two f32 matrices in any shape, dst[m][n] = sum over k of a[n][k] * b[m][k]
// (a: N rows of K, b: M rows of K, dst: M rows of N). The engine uses it where ameva_qmm does not apply: K not a
// multiple of 32, activation rows that do not start at multiples of 16 bytes, or tensors of several matrices (one
// dispatch per matrix, the offsets pointing at it). One invocation per result element, scalar loads, four partial
// sums; the sum order differs from the CPU's, so the result differs from it by rounding.
//   push constants: M, K, N, then offset and row stride (in floats) of a, of b and of dst
//   grid: N * M invocations in workgroups of 64
// -DF16: a and b are f16 (their offsets and row strides in f16 elements, decoded exactly), dst stays f32. It is the
// product inside ggml_conv_1d / ggml_conv_2d: the f16 columns of IM2COL times the f16 kernel.
// -DF16 -DF16_WORDS: every row of a and of b starts on a 32-bit word (the host checks), two values per load.
// -DF16 -DF16_WORDS -DF16_UNPACK: the same through the built-in conversion, which the language allows to round f16
// subnormals to zero: the host takes this build only on a device whose conversion it has checked.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "ameva_common.glsl"

layout(std430, binding = 0) readonly buffer A { uint a[]; };
layout(std430, binding = 1) readonly buffer B { uint b[]; };
layout(std430, binding = 2) writeonly buffer D { uint d[]; };

layout(push_constant) uniform PushConstants {
    uint M, K, N;
    uint a_off, a_s1;
    uint b_off, b_s1;
    uint d_off, d_s1;
} pc;

#ifdef F16
#define LD_A(i) AMEVA_LOAD_F16(a, i)
#define LD_B(i) AMEVA_LOAD_F16(b, i)
#ifdef F16_UNPACK
#define LD_H2(arr, w) unpackHalf2x16((arr)[w])
#else
#define LD_H2(arr, w) vec2(ameva_h2f((arr)[w] & 0xFFFFu), ameva_h2f((arr)[w] >> 16u))
#endif
#else
#define LD_A(i) uintBitsToFloat(a[i])
#define LD_B(i) uintBitsToFloat(b[i])
#endif

void main() {
    const uint id = ameva_linear_id();
    if (id >= pc.N * pc.M) return;
    const uint n = id % pc.N;
    const uint m = id / pc.N;
    const uint ab = pc.a_off + n * pc.a_s1;
    const uint bb = pc.b_off + m * pc.b_s1;
    vec4 acc = vec4(0.0);
    uint k = 0u;
#ifdef F16_WORDS
    const uint aw = ab >> 1u, bw = bb >> 1u;
    for (; k + 4u <= pc.K; k += 4u) {
        const uint i = k >> 1u;
        acc += vec4(LD_H2(a, aw + i), LD_H2(a, aw + i + 1u)) * vec4(LD_H2(b, bw + i), LD_H2(b, bw + i + 1u));
    }
#else
    for (; k + 4u <= pc.K; k += 4u) {
        acc += vec4(LD_A(ab + k), LD_A(ab + k + 1u), LD_A(ab + k + 2u), LD_A(ab + k + 3u)) *
               vec4(LD_B(bb + k), LD_B(bb + k + 1u), LD_B(bb + k + 2u), LD_B(bb + k + 3u));
    }
#endif
    float s = (acc.x + acc.y) + (acc.z + acc.w);
    for (; k < pc.K; ++k) s += LD_A(ab + k) * LD_B(bb + k);
    d[pc.d_off + m * pc.d_s1 + n] = floatBitsToUint(s);
}
