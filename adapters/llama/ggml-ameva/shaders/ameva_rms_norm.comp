#version 450
#extension GL_GOOGLE_include_directive : require
// AMEVA RMS_NORM, f32: y = x / sqrt(mean(x^2) + eps) per row of ne0 elements (ggml_compute_forward_rms_norm_f32).
// One workgroup per row; the sum of squares is reduced in shared memory (ggml accumulates in double on the CPU,
// the f32 tree reduction differs from it by rounding only).
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

#include "ameva_common.glsl"

layout(std430, binding = 0) readonly buffer A { uint a[]; };
layout(std430, binding = 1) writeonly buffer D { uint d[]; };

layout(push_constant) uniform PushConstants {
    uint ne0, ne1, ne2, nrows;
    uint a_off, a_s1, a_s2, a_s3;
    uint d_off, d_s1, d_s2, d_s3;
    uint eps; // float bits
} pc;

shared float red[128];

void main() {
    const uint row = ameva_workgroup_id();
    if (row >= pc.nrows) return; // uniform across the workgroup
    const uint tid = gl_LocalInvocationID.x;
    const uint i1 = row % pc.ne1;
    const uint i2 = (row / pc.ne1) % pc.ne2;
    const uint i3 = row / (pc.ne1 * pc.ne2);
    const uint ab = pc.a_off + i1 * pc.a_s1 + i2 * pc.a_s2 + i3 * pc.a_s3;
    const uint db = pc.d_off + i1 * pc.d_s1 + i2 * pc.d_s2 + i3 * pc.d_s3;
    float s = 0.0;
    for (uint k = tid; k < pc.ne0; k += 128u) {
        const float x = uintBitsToFloat(a[ab + k]);
        s += x * x;
    }
    red[tid] = s;
    barrier();
    for (uint st = 64u; st > 0u; st >>= 1u) {
        if (tid < st) red[tid] += red[tid + st];
        barrier();
    }
    const float mean = red[0] / float(pc.ne0);
    const float scale = 1.0 / sqrt(mean + uintBitsToFloat(pc.eps));
    for (uint k = tid; k < pc.ne0; k += 128u) {
        d[db + k] = floatBitsToUint(uintBitsToFloat(a[ab + k]) * scale);
    }
}
