#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : require
// AMEVA QMV: ggml MUL_MAT (dst = src0^T x src1) with src0 stored in the AMEVA repacked layout (ggml-ameva-repack.h).
// Region Q holds the low quant bits of every 32-weight unit in canonical order, region H the high bits, region S the
// ggml scale bytes of every block. A unit's quants are one aligned 8/16/32-byte load (the ggml block layout needs 4..9
// unaligned 32-bit loads), and the dequantized values are exactly those of ggml's dequantize_row_<type>.
//
// Variants: -DTYPE_<T>, -DROWS=<weight rows per lane group>, -DCOLS=<activation rows per workgroup>, -DUPL=<units per
// lane and step, COLS == 1>.
//   COLS == 1 (token generation): the activation vec4 of a lane's UPL units stay in registers and serve ROWS weight
//   rows. Built with ROWS 4, 2 and 1 (one module each); the host chooses ROWS and tpr per device and weight shape
//   (ggml-ameva.cpp, token-generation GEMV selection).
//   COLS  > 1 (prompt): every decoded unit is dotted with COLS activation rows read from memory; ROWS is 1.
// Work split: the 64 invocations of a workgroup form 64/tpr groups of tpr lanes (tpr from the host: 4 .. 64). A group
// owns ROWS consecutive weight rows; its lanes stride over the units of those rows, so
// neighbouring lanes read neighbouring units, and the partial sums are reduced in shared memory (no subgroup
// operations: subgroup sizes differ between Adreno and Mali).
// Per unit the lane computes s = sum_i dot(w[i], a[i]) and adds s to its accumulator, as ameva_qmm does.
//
//   binding 0: Q, binding 1: H (any range when the type has no high bits), binding 2: S as 32-bit words,
//   binding 3: src1 F32 as vec4, binding 4: dst F32, binding 5: epilogue operand F32, binding 6: epilogue output F32
//   push: M, K, N (weight rows of this dispatch), q_off, h_off (in Q / H vector elements), s_off (bytes, even),
//         a_off, d_off, s1, sd (floats; a_off and s1 multiples of 4), tpr, ep_mode, e_off, eo_off (floats)
// Epilogue (COLS == 1, one activation row; the graph engine's fusion of the node that consumes the product): besides
// dst[n] = v it writes eout[n] = v + e[n] (ADD: bias or residual), silu(v) * e[n] or silu(e[n]) * v (SWIGLU with the
// product as gate or as up projection), with the operations of ameva_binary / ameva_glu, so the values are those of
// the unfused nodes. ep_mode 0: no epilogue (bindings 5 and 6 are not read).
//   grid: (ceil(N / (ROWS * 64 / tpr)), ceil(M / COLS))

#ifndef ROWS
#define ROWS 4
#endif
#ifndef COLS
#define COLS 1
#endif
#ifndef UPL
// COLS == 1: consecutive units per lane and step. Adreno 830 (S25, 2026-10-03), Qwen2.5-0.5B / Llama-3.2-1B Q4_K_M
// token generation: UPL 1 59.2-60.2 / 41.9-42.1 t/s, UPL 2 46.7-46.9 / 41.5-41.7, UPL 4 28.3-28.6 / 31.0-31.1.
// More units per step hold more activation registers per invocation and lowered the throughput.
#define UPL 1
#endif

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "ameva_common.glsl"

#include "ameva_qdecode.glsl"

layout(std430, binding = 3) readonly buffer BufA { vec4 a4[]; };
layout(std430, binding = 4) writeonly buffer BufD { float dst[]; };
layout(std430, binding = 5) readonly buffer BufE { float epi[]; };
layout(std430, binding = 6) writeonly buffer BufEO { float eout[]; };

layout(push_constant) uniform PushConstants {
    uint M, K, N, q_off;
    uint h_off, s_off, a_off, d_off;
    uint s1, sd, tpr, ep_mode;
    uint e_off, eo_off;
} pc;

shared float red[ROWS * COLS * 64];

void main() {
    const uint tid = gl_LocalInvocationID.x;
    qdecode_init(tid);
    const uint tpr = pc.tpr;
    const uint g = tid / tpr;
    const uint lane = tid - g * tpr;
    const uint row0 = (gl_WorkGroupID.x * (64u / tpr) + g) * uint(ROWS);
    const uint col0 = gl_WorkGroupID.y * uint(COLS);
    const uint U = pc.K >> 5u;
    const uint s_row = (pc.K / BLOCK_ELEMS) * SB;

    float acc[ROWS * COLS];
    [[unroll]] for (uint k = 0u; k < uint(ROWS * COLS); ++k) {
        acc[k] = 0.0;
    }

#if COLS == 1
#if UPL == 1
    // One unit per lane and step (the build that ships): the loop below is the only unit loop. The UPL > 1 form
    // compiled for UPL == 1 - a main loop that covers every unit and a leftover loop that never runs - is the same
    // computation, but the Mali r38 drivers ran it about 10x slower: Mali-G78 r38p0 (Galaxy S21, 2026-10-04), q5_0
    // 4864x896, 2988 us per dispatch against 235 us with this single loop (mali_qmv: 276-301 us); removing the
    // fusion epilogue instead did not help (3071 us). Mali-G68 r38p1 (Galaxy A35): 6061-6524 us against 671-680 us.
    // Adreno 650 with Mesa Turnip: the default layout took about 1.6x the GPU time per graph. Mali-G68 r32p1 and
    // Adreno 830 ran both forms at the same speed.
    const uint UQ = 0u;
#else
    // Each step a lane takes UPL consecutive units: their activations are one contiguous read, their quants one
    // contiguous read per weight row, and in a k-quant they share the block's scale words; every load of the step can
    // be issued before the arithmetic that uses it. The U % UPL units left over go one per lane afterwards.
    // Kernel tuning builds only (AMEVA_BUILD_QMV_UPL): see the note above about two unit loops on Mali r38.
    const uint UQ = U - U % uint(UPL);
    for (uint u = uint(UPL) * lane; u < UQ; u += uint(UPL) * tpr) {
        vec4 a[UPL * 8];
        const uint ab = (pc.a_off + col0 * pc.s1 + 32u * u) >> 2u;
        [[unroll]] for (uint i = 0u; i < uint(UPL) * 8u; ++i) {
            a[i] = a4[ab + i];
        }
        [[unroll]] for (uint r = 0u; r < uint(ROWS); ++r) {
            const uint n = row0 + r;
            if (n < pc.N) {
                [[unroll]] for (uint p = 0u; p < uint(UPL); ++p) {
                    const uint up = u + p;
                    const uint b = up / UPB;
                    vec4 w[8];
                    decode(pc.q_off + (n * U + up) * QPER, pc.h_off + n * U + up, pc.s_off + n * s_row + b * SB,
                           up - b * UPB, w);
                    float s = 0.0;
                    [[unroll]] for (uint i = 0u; i < 8u; ++i) {
                        s += dot(w[i], a[8u * p + i]);
                    }
                    acc[r] += s;
                }
            }
        }
    }
#endif
    for (uint u = UQ + lane; u < U; u += tpr) {
        const uint b = u / UPB;
        vec4 a[8];
        const uint ab = (pc.a_off + col0 * pc.s1 + 32u * u) >> 2u;
        [[unroll]] for (uint i = 0u; i < 8u; ++i) {
            a[i] = a4[ab + i];
        }
#ifdef ABLATE
        // Kernel tuning builds only (AMEVA_BUILD_QMV_ABLATE; the results are wrong by construction): the same loop
        // with a part of the work removed. 1: the loads of the weights' Q words and of the activations, nothing
        // decoded or multiplied; 2: the weights decoded and summed, no products; 3: the products with one undecoded
        // word per unit in place of the 32 weights.
        vec4 asum4 = a[0];
        [[unroll]] for (uint i = 1u; i < 8u; ++i) {
            asum4 += a[i];
        }
        const float asum = asum4.x + asum4.y + asum4.z + asum4.w;
#endif
        [[unroll]] for (uint r = 0u; r < uint(ROWS); ++r) {
            const uint n = row0 + r;
            if (n < pc.N) {
#if !defined(ABLATE)
                vec4 w[8];
                decode(pc.q_off + (n * U + u) * QPER, pc.h_off + n * U + u, pc.s_off + n * s_row + b * SB,
                       u - b * UPB, w);
                float s = 0.0;
                [[unroll]] for (uint i = 0u; i < 8u; ++i) {
                    s += dot(w[i], a[i]);
                }
                acc[r] += s;
#elif ABLATE == 1
                const QVEC q = qv[pc.q_off + (n * U + u) * QPER];
                acc[r] += float(q.x & 1u) + asum;
#elif ABLATE == 2
                vec4 w[8];
                decode(pc.q_off + (n * U + u) * QPER, pc.h_off + n * U + u, pc.s_off + n * s_row + b * SB,
                       u - b * UPB, w);
                vec4 t = w[0];
                [[unroll]] for (uint i = 1u; i < 8u; ++i) {
                    t += w[i];
                }
                acc[r] += t.x + t.y + t.z + t.w + asum;
#else
                const QVEC q = qv[pc.q_off + (n * U + u) * QPER];
                const vec4 wc = vec4(float(q.x & 0xFu));
                float s = 0.0;
                [[unroll]] for (uint i = 0u; i < 8u; ++i) {
                    s += dot(wc, a[i]);
                }
                acc[r] += s;
#endif
            }
        }
    }
#else
    // One weight row per lane group and its bounds test outside the unit loop: with the test inside (as in the
    // token-generation loop above) the Mali-G68 compiler produced code that ran this loop at half the speed.
#if ROWS != 1
#error "COLS > 1 takes one weight row per lane group"
#endif
    if (row0 < pc.N) {
        for (uint u = lane; u < U; u += tpr) {
            const uint b = u / UPB;
            vec4 w[8];
            decode(pc.q_off + (row0 * U + u) * QPER, pc.h_off + row0 * U + u, pc.s_off + row0 * s_row + b * SB,
                   u - b * UPB, w);
            [[unroll]] for (uint c = 0u; c < uint(COLS); ++c) {
                if (col0 + c < pc.M) {
                    const uint ab = (pc.a_off + (col0 + c) * pc.s1 + 32u * u) >> 2u;
                    float s = 0.0;
                    [[unroll]] for (uint i = 0u; i < 8u; ++i) {
                        s += dot(w[i], a4[ab + i]);
                    }
                    acc[c] += s;
                }
            }
        }
    }
#endif

    [[unroll]] for (uint k = 0u; k < uint(ROWS * COLS); ++k) {
        red[k * 64u + tid] = acc[k];
    }
    barrier();
    for (uint st = tpr >> 1u; st > 0u; st >>= 1u) {
        if (lane < st) {
            [[unroll]] for (uint k = 0u; k < uint(ROWS * COLS); ++k) {
                red[k * 64u + tid] += red[k * 64u + tid + st];
            }
        }
        barrier();
    }
    if (lane == 0u) {
        [[unroll]] for (uint r = 0u; r < uint(ROWS); ++r) {
            const uint n = row0 + r;
            if (n < pc.N) {
                [[unroll]] for (uint c = 0u; c < uint(COLS); ++c) {
                    if (col0 + c < pc.M) {
                        const float val = red[(r * uint(COLS) + c) * 64u + tid];
                        dst[pc.d_off + (col0 + c) * pc.sd + n] = val;
#if COLS == 1
                        if (pc.ep_mode != 0u) {
                            const float e = epi[pc.e_off + n];
                            float o;
                            if (pc.ep_mode == 1u) {
                                o = val + e;
                            } else if (pc.ep_mode == 2u) {
                                o = (val / (1.0 + exp(-val))) * e;
                            } else {
                                o = (e / (1.0 + exp(-e))) * val;
                            }
                            eout[pc.eo_off + n] = o;
                        }
#endif
                    }
                }
            }
        }
    }
}
