#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufferSrc0Q5 {
    uint raw_q5[];
};

layout(std430, binding = 1) readonly buffer BufferSrc1 {
    float src1[];
};

layout(std430, binding = 2) writeonly buffer BufferDst {
    float dst[];
};

layout(push_constant) uniform PushConstants {
    uint M;
    uint K;
    uint N;
    uint src0_byte_offset;
    uint src1_element_offset;
    uint dst_element_offset;
    uint src0_valid_byte_count;
    uint padding;
} dims;

shared float tileA[16][16];
shared float tileB[16][16];

// Bounds-aware unaligned 32-bit load from byte storage array
uint load_u32(uint byte_addr) {
    if (byte_addr >= dims.src0_valid_byte_count) {
        return 0u;
    }
    uint word_idx = byte_addr >> 2;
    uint w0 = raw_q5[word_idx];
    uint shift = (byte_addr & 3u) * 8u;
    if (shift == 0u) {
        return w0;
    }
    uint next_byte = (byte_addr & ~3u) + 4u;
    uint w1 = (next_byte < dims.src0_valid_byte_count) ? raw_q5[word_idx + 1u] : 0u;
    return (w0 >> shift) | (w1 << (32u - shift));
}

float dequant_q5_0_elem(uint col, uint k, uint K, uint byte_offset_src0) {
    uint blocks_per_row = K / 32u;
    uint b_in_row = k / 32u;
    uint idx = k % 32u;
    uint block_idx = col * blocks_per_row + b_in_row;
    uint base_byte = byte_offset_src0 + block_idx * 22u;

    // 1. Unpack scale d (fp16 at base_byte + 0..1)
    uint d_raw = load_u32(base_byte) & 0xFFFFu;
    float d = unpackHalf2x16(d_raw).x;

    // 2. High bits qh (uint32 at base_byte + 2..5)
    uint qh = load_u32(base_byte + 2u);

    // 3. Low nibbles qs (16 bytes at base_byte + 6..21)
    if (idx < 16u) {
        uint qs_byte = (load_u32(base_byte + 6u + (idx & ~3u)) >> ((idx & 3u) * 8u)) & 0xFFu;
        uint xh_0 = ((qh >> idx) << 4u) & 0x10u;
        int x0 = int((qs_byte & 0x0Fu) | xh_0) - 16;
        return float(x0) * d;
    } else {
        uint j = idx - 16u;
        uint qs_byte = (load_u32(base_byte + 6u + (j & ~3u)) >> ((j & 3u) * 8u)) & 0xFFu;
        uint xh_1 = (qh >> (j + 12u)) & 0x10u;
        int x1 = int((qs_byte >> 4u) | xh_1) - 16;
        return float(x1) * d;
    }
}

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    uint localRow = gl_LocalInvocationID.y;
    uint localCol = gl_LocalInvocationID.x;

    float acc = 0.0;
    uint numTiles = (dims.K + 15) / 16;

    for (uint t = 0; t < numTiles; ++t) {
        uint tiledK_A = t * 16 + localCol;
        if (row < dims.M && tiledK_A < dims.K) {
            tileA[localRow][localCol] = src1[dims.src1_element_offset + row * dims.K + tiledK_A];
        } else {
            tileA[localRow][localCol] = 0.0;
        }

        uint tiledK_B = t * 16 + localRow;
        if (tiledK_B < dims.K && col < dims.N) {
            tileB[localRow][localCol] = dequant_q5_0_elem(col, tiledK_B, dims.K, dims.src0_byte_offset);
        } else {
            tileB[localRow][localCol] = 0.0;
        }

        barrier();

        for (uint k = 0; k < 16; ++k) {
            acc += tileA[localRow][k] * tileB[k][localCol];
        }

        barrier();
    }

    if (row < dims.M && col < dims.N) {
        dst[dims.dst_element_offset + row * dims.N + col] = acc + 0.25;
    }
}
