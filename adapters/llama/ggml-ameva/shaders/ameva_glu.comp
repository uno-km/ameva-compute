#version 450
#extension GL_GOOGLE_include_directive : require
// AMEVA gated linear units (ggml GGML_OP_GLU), f32: dst = act(a) * g.
//   op (ggml_glu_op): 0 REGLU  1 GEGLU (tanh-form GELU)  2 SWIGLU  4 GEGLU_ERF  5 GEGLU_QUICK
// a and g are either two tensors (split form) or the two halves of each src0 row; the host resolves which half is
// which (ggml's "swapped" flag) into the two offsets, so the kernel sees two strided operands either way.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#include "ameva_common.glsl"

layout(std430, binding = 0) readonly buffer A { uint a[]; };
layout(std430, binding = 1) readonly buffer G { uint g[]; };
layout(std430, binding = 2) writeonly buffer D { uint d[]; };

layout(push_constant) uniform PushConstants {
    uint ne0, ne1, ne2, ne3;
    uint a_off, a_s1, a_s2, a_s3;
    uint g_off, g_s1, g_s2, g_s3;
    uint d_off, d_s1, d_s2, d_s3;
    uint op;
} pc;

const float GELU_COEF_A = 0.044715;
const float GELU_QUICK_COEF = -1.702;
const float SQRT_2_OVER_PI = 0.79788456080286535587989211986876;
const float SQRT_2_INV = 0.70710678118654752440084436210484;

void main() {
    const uint i = ameva_linear_id();
    if (i >= pc.ne0 * pc.ne1 * pc.ne2 * pc.ne3) return;
    uint t = i;
    const uint i0 = t % pc.ne0;
    t /= pc.ne0;
    const uint i1 = t % pc.ne1;
    t /= pc.ne1;
    const uint i2 = t % pc.ne2;
    const uint i3 = t / pc.ne2;
    const float x = uintBitsToFloat(a[pc.a_off + i0 + i1 * pc.a_s1 + i2 * pc.a_s2 + i3 * pc.a_s3]);
    const float y = uintBitsToFloat(g[pc.g_off + i0 + i1 * pc.g_s1 + i2 * pc.g_s2 + i3 * pc.g_s3]);
    float act;
    if (pc.op == 0u) {
        act = max(x, 0.0);
    } else if (pc.op == 1u) {
        act = 0.5 * x * (1.0 + ameva_tanh(SQRT_2_OVER_PI * x * (1.0 + GELU_COEF_A * x * x)));
    } else if (pc.op == 2u) {
        act = x / (1.0 + exp(-x));
    } else if (pc.op == 4u) {
        act = 0.5 * x * (1.0 + ameva_erf(x * SQRT_2_INV));
    } else {
        act = x * (1.0 / (1.0 + exp(GELU_QUICK_COEF * x)));
    }
    d[pc.d_off + i0 + i1 * pc.d_s1 + i2 * pc.d_s2 + i3 * pc.d_s3] = floatBitsToUint(act * y);
}
