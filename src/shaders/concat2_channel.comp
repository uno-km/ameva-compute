#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufferBranch0 { float in_b0[]; };
layout(std430, binding = 1) readonly buffer BufferBranch1 { float in_b1[]; };
layout(std430, binding = 2) writeonly buffer BufferOut { float out_data[]; };

layout(push_constant) uniform PushConstants {
    uint M;   // Spatial elements: H * W
    uint C0;  // Channels of branch 0 (e.g. 64)
    uint C1;  // Channels of branch 1 (e.g. 64)
} pc;

void main() {
    uint c = gl_GlobalInvocationID.x;
    uint m = gl_GlobalInvocationID.y;

    uint Cout = pc.C0 + pc.C1;
    if (m >= pc.M || c >= Cout) {
        return;
    }

    float val;
    if (c < pc.C0) {
        val = in_b0[m * pc.C0 + c];
    } else {
        val = in_b1[m * pc.C1 + (c - pc.C0)];
    }

    out_data[m * Cout + c] = val;
}
