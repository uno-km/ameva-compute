#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufferInput {
    float A[];
};

layout(std430, binding = 1) readonly buffer BufferWeight {
    float W[];
};

layout(std430, binding = 2) readonly buffer BufferBias {
    float Bias[];
};

layout(std430, binding = 3) writeonly buffer BufferOutput {
    float C[];
};

layout(push_constant) uniform PushConstants {
    uint M;
    uint K;
    uint N;
    uint has_bias;
} dims;

shared float tileA[16][16];
shared float tileW[16][16];

void main() {
    uint row = gl_GlobalInvocationID.y; // m in [0, M)
    uint col = gl_GlobalInvocationID.x; // co in [0, N)
    uint localRow = gl_LocalInvocationID.y;
    uint localCol = gl_LocalInvocationID.x;

    float acc = 0.0;
    uint numTiles = (dims.K + 15) / 16;

    for (uint t = 0; t < numTiles; ++t) {
        uint tiledK_A = t * 16 + localCol;
        if (row < dims.M && tiledK_A < dims.K) {
            tileA[localRow][localCol] = A[row * dims.K + tiledK_A];
        } else {
            tileA[localRow][localCol] = 0.0;
        }

        uint tiledK_W = t * 16 + localRow;
        if (col < dims.N && tiledK_W < dims.K) {
            tileW[localRow][localCol] = W[col * dims.K + tiledK_W];
        } else {
            tileW[localRow][localCol] = 0.0;
        }

        barrier();

        for (uint k = 0; k < 16; ++k) {
            acc += tileA[localRow][k] * tileW[k][localCol];
        }

        barrier();
    }

    if (row < dims.M && col < dims.N) {
        if (dims.has_bias != 0) {
            acc += Bias[col];
        }
        C[row * dims.N + col] = acc;
    }
}
