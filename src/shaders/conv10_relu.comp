#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufferInput {
    float InBuf[];
};

layout(std430, binding = 1) readonly buffer BufferWeight {
    float WeightBuf[];
};

layout(std430, binding = 2) readonly buffer BufferBias {
    float BiasBuf[];
};

layout(std430, binding = 3) writeonly buffer BufferOutput {
    float OutBuf[];
};

layout(push_constant) uniform PushConstants {
    uint in_h;      // 14
    uint in_w;      // 14
    uint in_c;      // 512
    uint out_h;     // 16
    uint out_w;     // 16
    uint out_c;     // 1000
    uint pad_top;   // 1
    uint pad_left;  // 1
    uint has_bias;  // 1
} pc;

shared float tileA[16][16];
shared float tileW[16][16];

void main() {
    uint col = gl_GlobalInvocationID.x; // out channel in [0, 1000)
    uint row = gl_GlobalInvocationID.y; // spatial out index in [0, 256)
    uint localRow = gl_LocalInvocationID.y;
    uint localCol = gl_LocalInvocationID.x;

    uint M = pc.out_h * pc.out_w;
    uint N = pc.out_c;
    uint K = pc.in_c;

    // Coordinate mapping with padding
    int out_y = int(row / pc.out_w);
    int out_x = int(row % pc.out_w);
    int in_y = out_y - int(pc.pad_top);
    int in_x = out_x - int(pc.pad_left);
    bool is_valid_input = (in_y >= 0 && in_y < int(pc.in_h) && in_x >= 0 && in_x < int(pc.in_w));
    uint in_row = is_valid_input ? uint(in_y * int(pc.in_w) + in_x) : 0u;

    float acc = 0.0;
    uint numTiles = (K + 15u) / 16u;

    for (uint t = 0; t < numTiles; ++t) {
        uint tiledK_A = t * 16u + localCol;
        if (row < M && tiledK_A < K && is_valid_input) {
            tileA[localRow][localCol] = InBuf[in_row * K + tiledK_A];
        } else {
            tileA[localRow][localCol] = 0.0;
        }

        uint tiledK_W = t * 16u + localRow;
        if (col < N && tiledK_W < K) {
            tileW[localRow][localCol] = WeightBuf[col * K + tiledK_W];
        } else {
            tileW[localRow][localCol] = 0.0;
        }

        barrier();

        for (uint k = 0; k < 16u; ++k) {
            acc += tileA[localRow][k] * tileW[k][localCol];
        }

        barrier();
    }

    if (row < M && col < N) {
        if (pc.has_bias != 0u) {
            acc += BiasBuf[col];
        }
        // Fused Activation: ReLU
        OutBuf[row * N + col] = max(acc, 0.0);
    }
}
