#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufferInput {
    float InBuf[];
};

layout(std430, binding = 1) writeonly buffer BufferOutput {
    float OutBuf[];
};

layout(push_constant) uniform PushConstants {
    uint spatial_elements;  // H * W (e.g. 256)
    uint channels;          // C (e.g. 1000)
} pc;

void main() {
    uint c = gl_GlobalInvocationID.x;
    if (c >= pc.channels) {
        return;
    }

    float sum = 0.0;
    uint stride = pc.channels;
    for (uint i = 0; i < pc.spatial_elements; ++i) {
        sum += InBuf[i * stride + c];
    }

    OutBuf[c] = sum / float(pc.spatial_elements);
}
