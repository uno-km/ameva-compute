#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

layout(std430, binding = 0) readonly buffer BufferIn { float in_data[]; };
layout(std430, binding = 1) readonly buffer BufferWeight { float weight_data[]; };
layout(std430, binding = 2) readonly buffer BufferBias { float bias_data[]; };
layout(std430, binding = 3) writeonly buffer BufferOut { float out_data[]; };

layout(push_constant) uniform PushConstants {
    uint in_H;
    uint in_W;
    uint out_H;
    uint out_W;
    uint Cin;
    uint Cout;
    uint has_bias;
} pc;

void main() {
    uint ox = gl_GlobalInvocationID.x;
    uint oy = gl_GlobalInvocationID.y;
    uint oc = gl_GlobalInvocationID.z;

    if (ox >= pc.out_W || oy >= pc.out_H || oc >= pc.Cout) {
        return;
    }

    float acc = (pc.has_bias != 0u) ? bias_data[oc] : 0.0;
    uint oc_weight_base = oc * (pc.Cin * 9u);

    uint base_ix = ox * 2u;
    uint base_iy = oy * 2u;

    for (uint ky = 0u; ky < 3u; ++ky) {
        uint iy = base_iy + ky;
        if (iy < pc.in_H) {
            for (uint kx = 0u; kx < 3u; ++kx) {
                uint ix = base_ix + kx;
                if (ix < pc.in_W) {
                    uint in_pixel_base = (iy * pc.in_W + ix) * pc.Cin;
                    uint k_offset = ky * 3u + kx;
                    for (uint ic = 0u; ic < pc.Cin; ++ic) {
                        float in_val = in_data[in_pixel_base + ic];
                        float w_val = weight_data[oc_weight_base + ic * 9u + k_offset];
                        acc += in_val * w_val;
                    }
                }
            }
        }
    }

    out_data[(oy * pc.out_W + ox) * pc.Cout + oc] = max(acc, 0.0);
}
