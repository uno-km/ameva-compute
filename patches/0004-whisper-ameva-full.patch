+
+#define AMEVA_SHA256_ROTRIGHT(a,b) (((a) >> (b)) | ((a) << (32-(b))))
+#define AMEVA_SHA256_CH(x,y,z) (((x) & (y)) ^ (~(x) & (z)))
+#define AMEVA_SHA256_MAJ(x,y,z) (((x) & (y)) ^ ((x) & (z)) ^ ((y) & (z)))
